{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playunpause",
  "account_id": "576c33d5e81e2ec90e0d62c532cbe330",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "playunpause.com",
      "custom_domain": true
    },
    {
      "pattern": "www.playunpause.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "playunpause-db",
      "database_id": "af58ee7f-491b-4bce-a3ce-515de3d02aaf"
    }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "NODE_ENV": "production",
    "PUBLIC_SITE_URL": "https://playunpause.com",
    "SUPPORT_EMAIL": "hello@playunpause.com",
    "SPONSOR_EMAIL": "sponsors@playunpause.com",
    "ALLOW_DEMO_UNLOCK": "false",
    "WHOP_PASS_CHECKOUT_URL": "https://whop.com/playunpause/unpause-one-time-all-access-pass/",
    "WHOP_SPONSOR_CHECKOUT_URL": "https://whop.com/playunpause/unpause-24-hour-featured-header-sponsor/",
    "WHOP_PASS_PLAN_ID": "prod_oMcH19N9BCoDO",
    "WHOP_SPONSOR_PLAN_ID": "prod_QrrVpAuy4GAUm"
  }
}
