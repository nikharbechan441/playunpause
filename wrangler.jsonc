{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playunpause",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "NODE_ENV": "production",
    "PUBLIC_SITE_URL": "https://playunpause.com",
    "SUPPORT_EMAIL": "hello@playunpause.com",
    "SPONSOR_EMAIL": "sponsors@playunpause.com",
    "ALLOW_DEMO_UNLOCK": "false",
    "WHOP_PASS_CHECKOUT_URL": "https://whop.com/playunpause/unpause-one-time-all-access-pass/",
    "WHOP_SPONSOR_CHECKOUT_URL": "https://whop.com/playunpause/unpause-24-hour-featured-header-sponsor/",
    "WHOP_PASS_PLAN_ID": "prod_oMcH19N9BCoDO",
    "WHOP_SPONSOR_PLAN_ID": "prod_QrrVpAuy4GAUm"
  }
}
